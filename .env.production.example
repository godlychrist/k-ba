APP_NAME="K Gastos"
APP_ENV=production
APP_DEBUG=false
# Keep the existing key when using existing encrypted mail accounts.
APP_KEY=
APP_URL=https://k-fa.vercel.app
FRONTEND_URL=https://k-fa.vercel.app

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
FILESYSTEM_DISK=local

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://k-fa.vercel.app/auth/gmail/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://k-fa.vercel.app/auth/outlook/callback
